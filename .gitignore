# --- Secrets（最優先・コミット事故の再発防止） ---
.env
.env.*
!.env.example
config/master.key
**/config/master.key
**/config/credentials/*.key
*.pem
*.key
!*.pub.key

# --- .claude/ の扱いはリポジトリの公開設定で決める ---
# PUBLICリポジトリ：以下を有効化し、.claude/を丸ごと除外する（社内ノウハウの公開防止。questboardで実施済み）
.claude/*
#
# PRIVATEリポジトリ：上の行をコメントアウトし、.claude/を丸ごとコミットする
# （露出リスクが無く、クローン直後からsettings.json・agents・workflowsが動く。x-follower-gateで実施済み）

# --- ノウハウ・非公開ディレクトリ（公開/非公開に関わらず常に除外） ---
CLIENT/
DEBUG/
TASKS/
WORK/
DELETE/
ENV/

# --- Rails ---
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
.byebug_history
/public/assets
src/backend/log/*
src/backend/tmp/*
!src/backend/log/.keep
!src/backend/tmp/.keep
src/backend/public/assets
src/backend/config/master.key
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# --- Node / Next.js / Vercel ---
node_modules/
.next/
out/
.vercel

# --- Python / FastAPI ---
__pycache__/
*.pyc
.venv/
venv/

# --- Go ---
/bin/
src/relay/bin/
src/relay/tmp/
src/relay/*.exe
src/relay/relay

# --- Rust / Tauri ---
target/
src-tauri/target/

# --- Unity ---
/Library/
/Temp/
/Obj/
/Build/
/Logs/
/UserSettings/
/MemoryCaptures/
*.csproj
*.sln

# --- Playwright ---
test-results/
playwright-report/
/.playwright-mcp/

# --- エディタ・OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*Zone.Identifier

# --- テスト・カバレッジ ---
coverage/
.rspec_status
